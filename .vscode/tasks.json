{
  // 比 Code Runner 更可靠:路径由 VS Code 原生变量解析,args 自动正确加引号
  // 用法:打开任意 .py 文件,按 Ctrl+Shift+B(或菜单 终端 -> 运行生成任务)
  "version": "2.0.0",
  "tasks": [
    {
      "label": "运行当前 Python 文件 (venv)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-u", "${file}"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "echo": true
      }
    }
  ]
}
