{
  // 指定项目解释器:uv venv 创建的 .venv(已装 regex)
  // 打开 VS Code 后如有提示,选 "Use .venv" 即可;也可 Ctrl+Shift+P -> Python: Select Interpreter
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.terminal.activateEnvironment": true,

  // Code Runner 默认执行 `python -u xxx.py`,会命中 WindowsApps 里的商店空壳并返回 9009。
  // 这里改成直接调用 .venv 里的解释器,并在终端里运行(便于看到输入/输出与报错)。
  // 注意:Code Runner 的变量是 $workspaceRoot / $fullFileName,不要用 VS Code 的 ${workspaceFolder}。
  // 本项目路径不含空格,因此不加引号最稳(加了引号反而容易被二次包裹成 ""..."" )。
  "code-runner.executorMap": {
    "python": "$workspaceRoot\\.venv\\Scripts\\python.exe -u $fullFileName"
  },
  "code-runner.runInTerminal": true,
  "code-runner.fileDirectoryAsCwd": true,
  "code-runner.saveFileBeforeRun": true,

  // 以后 uv sync 装好 torch 之后,可以直接在"测试"面板里跑 tests/test_train_bpe.py
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "tests"
  ]
}
